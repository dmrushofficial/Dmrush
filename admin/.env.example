# GEMINI_API_KEY: Optional. Used only if Gemini features are enabled in this panel.
GEMINI_API_KEY=

# APP_URL: Public URL for this admin app (include /admin path when hosted under dmrush.com).
APP_URL=https://dmrush.com/admin

# ADMIN_PORT: Local/admin Node server port (Next.js proxies /admin here).
# Keep off 3000 (website) and 3001 (Learn) — default 3005.
ADMIN_PORT=3005

# Vite base path — keep as /admin/ for dmrush.com/admin integration.
VITE_BASE_PATH=/admin/

# ADMIN_SESSION_SECRET: Required in production. Min 16 chars. Used to sign session cookies.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ADMIN_COOKIE_SECURE: Set "true" when the admin UI is served over HTTPS so the
# session cookie includes the Secure flag. Leave unset/false for local HTTP.
# ADMIN_COOKIE_SECURE=true

# LEARN_INTERNAL_URL: Learn app URL for auto student portal provisioning (default port 3001).
LEARN_INTERNAL_URL=http://127.0.0.1:3001

# LEARN_PUBLIC_URL: Login link shown to staff after admission (student-facing URL).
LEARN_PUBLIC_URL=http://localhost:3001/login

# LEARN_PROVISION_SECRET: Shared secret with Learn /api/internal/provision (min 16 chars in production).
LEARN_PROVISION_SECRET=dev-provision-secret
